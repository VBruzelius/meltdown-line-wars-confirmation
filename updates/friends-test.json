  "release_notes": {
    "title": "Combat Motion and Performance Polish",
    "summary": "Smoother repeated attacks and less repeated work during busy battles.",
    "url": "https://meltdownlinewars.se/news/combat-performance-polish/",
    "id": "combat-performance-polish-20261103",
    "channel": "TEST",
    "date": "2026-11-03",
    "sections": [
      {
        "title": "Improvements",
        "items": [
          "Reduced repeated model-size and Prismari attack preparation work during battles. Performance still depends on device and battle density.",
          "Knight, Clan Mauler and Arbalest attacks have gentler preparation and recovery, with their existing contact timing and equipment preserved."
        ]
      },
      {
        "title": "Fixes",
        "items": [
          "Repeated combat updates no longer rewind attack preparation between simulation steps. Damage, attack speed and gameplay rules are unchanged."
        ]
      },
      {
        "title": "Known issues",
        "items": [
          "Dense battles and simultaneous upgrades can still cause stutters. Further physical-phone performance testing is needed."
        ]
      }
    ]
  },
